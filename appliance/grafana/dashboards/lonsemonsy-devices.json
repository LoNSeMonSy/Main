    {
      "type": "stat",
      "title": "Remote access",
      "description": "Opening the dashboards from outside the office, over Tailscale with a 2-step sign-in. Turn it on or off on the server with: lsmsy remote",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"remote_access\" and (r._field == \"on\" or r._field == \"devices\"))\n  |> last()\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "on"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Remote access"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Off",
                        "color": "text"
                      },
                      "1": {
                        "text": "On",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "devices"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Devices that can connect"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "transparent"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Phones and laptops that can open the dashboards from outside",
      "description": "Everything signed in to this server's Tailscale account. Remove one at login.tailscale.com/admin/machines. A new one sets off the alarm \"New device can reach your dashboard\".",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 31
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"remote_device\")\n  |> last()\n  |> pivot(rowKey: [\"id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"online\", \"name\"], desc: true)\n  |> keep(columns: [\"name\", \"owner\", \"os\", \"online\", \"last_seen\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "name": 0,
              "owner": 1,
              "os": 2,
              "online": 3,
              "last_seen": 4
            },
            "renameByName": {
              "name": "Device",
              "owner": "Signed in as",
              "os": "System",
              "online": "Online",
              "last_seen": "Last seen"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Online"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "No"
                      },
                      "1": {
                        "text": "Yes",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    }
  ],
