    {
      "type": "table",
      "title": "Alarms going off now",
      "description": "Everything that is setting off an alarm right now. Older alerts are in the table below.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "timeFrom": "10m",
      "hideTimeOverride": true,
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "P45A1D828630779A3"
          },
          "timeField": "timestamp",
          "query": "rule.level:>=8 OR rule.id:86601 OR rule.id:651",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "50",
                "order": "desc"
              }
            }
          ],
          "bucketAggs": []
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "disk = from(bucket: \"monitoring\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"disk\" and r._field == \"used_percent\" and r.path == \"/\")\n  |> last()\n  |> filter(fn: (r) => r._value > 90.0)\n  |> map(fn: (r) => ({timestamp: r._time, desc: \"Disk almost full: \" + string(v: int(v: r._value)) + \"% used\"}))\nmem = from(bucket: \"monitoring\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"mem\" and r._field == \"used_percent\")\n  |> group()\n  |> mean()\n  |> filter(fn: (r) => r._value > 95.0)\n  |> map(fn: (r) => ({timestamp: r._stop, desc: \"Server low on memory: \" + string(v: int(v: r._value)) + \"% used\"}))\nunion(tables: [disk, mem])\n  |> map(fn: (r) => ({r with host: \"this server\"}))\n  |> rename(columns: {desc: \"rule.description\", host: \"agent.name\"})"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "P341AFF9E5CCA0B9F"
          },
          "queryType": "table",
          "queryText": "SELECT CAST(strftime('%s', devFirstConnection) AS INTEGER) AS timestamp, 'New device: ' || COALESCE(NULLIF(devName, '(name not found)'), devVendor, 'unknown') AS \"rule.description\", devLastIP AS \"data.srcip\" FROM Devices WHERE devIsArchived = 0 AND devLastIP NOT LIKE '172.20.0.%' AND devFirstConnection >= datetime('now', '-60 minutes')",
          "rawQueryText": "SELECT CAST(strftime('%s', devFirstConnection) AS INTEGER) AS timestamp, 'New device: ' || COALESCE(NULLIF(devName, '(name not found)'), devVendor, 'unknown') AS \"rule.description\", devLastIP AS \"data.srcip\" FROM Devices WHERE devIsArchived = 0 AND devLastIP NOT LIKE '172.20.0.%' AND devFirstConnection >= datetime('now', '-60 minutes')",
          "timeColumns": [
            "timestamp"
          ]
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "alias": "Account",
            "reduce": {
              "include": [
                "data.win.eventdata.targetUserName",
                "data.dstuser",
                "data.srcuser"
              ],
              "reducer": "firstNotNull"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "timestamp": true,
              "rule.description": true,
              "Account": true,
              "agent.name": true,
              "data.srcip": true,
              "_id": true
            },
            "indexByName": {
              "timestamp": 0,
              "rule.description": 1,
              "Account": 2,
              "agent.name": 3,
              "data.srcip": 4,
              "_id": 5
            },
            "renameByName": {
              "timestamp": "Time",
              "rule.description": "Alert",
              "agent.name": "Machine",
              "data.srcip": "From IP",
              "_id": "Wazuh"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          },
          "links": [],
          "noValue": "No alarms right now"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alert"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Host Blocked by firewall-drop Active Response": {
                        "text": "Attacker IP blocked for 10 minutes",
                        "color": "green",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Account"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              },
              {
                "id": "noValue",
                "value": " "
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Machine"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              },
              {
                "id": "noValue",
                "value": " "
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "From IP"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              },
              {
                "id": "noValue",
                "value": " "
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Wazuh"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "mappings",
