          "hide": true,
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "P341AFF9E5CCA0B9F"
          },
          "queryType": "table",
          "timeColumns": [],
          "queryText": "SELECT COUNT(*) AS new_devices FROM Devices WHERE devIsArchived = 0 AND devLastIP NOT LIKE '172.20.0.%' AND devFirstConnection >= datetime('now', '-60 minutes')",
          "rawQueryText": "SELECT COUNT(*) AS new_devices FROM Devices WHERE devIsArchived = 0 AND devLastIP NOT LIKE '172.20.0.%' AND devFirstConnection >= datetime('now', '-60 minutes')"
        },
        {
          "refId": "SA",
          "hide": true,
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "A",
          "reducer": "sum",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          }
        },
        {
          "refId": "SB",
          "hide": true,
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "B",
          "reducer": "sum",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          }
        },
        {
          "refId": "SC",
          "hide": true,
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "C",
          "reducer": "sum",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          }
        },
        {
          "refId": "F",
          "hide": true,
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"disk\" and r._field == \"used_percent\" and r.path == \"/\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        },
        {
          "refId": "SF",
          "hide": true,
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "F",
          "reducer": "last",
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          }
        },
        {
          "refId": "G",
          "hide": true,
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"mem\" and r._field == \"used_percent\")\n  |> mean()\n  |> keep(columns: [\"_time\", \"_value\"])"
        },
        {
          "refId": "SG",
          "hide": true,
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
