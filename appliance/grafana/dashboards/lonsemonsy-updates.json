{
  "uid": "lons-updates",
  "title": "Updates",
  "tags": [
    "lonsemonsy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "links": [
    {
      "title": "LoNSeMonSy",
      "type": "dashboards",
      "tags": [
        "lonsemonsy"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "apps",
      "targetBlank": false
    },
    {
      "title": "Wazuh",
      "type": "link",
      "url": "${wazuh:raw}",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Wazuh dashboard: the advanced view for IT people"
    },
    {
      "title": "Devices (NetAlertX)",
      "type": "link",
      "url": "${netalertx:raw}/devices.php",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Every device on the network"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Installed version",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_version\" and r._field == \"installed\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Newest version",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_version\" and r._field == \"latest\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Last checked (UTC)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_version\" and r._field == \"installed\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: string(v: r._time)}))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown"
        },
        "overrides": []
      }
    },
    {
      "type": "text",
      "title": "How to update",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "On the appliance, in the LoNSeMonSy folder:\n\n`sudo ./setup/update.sh`\n\nYour settings and data are kept. Back up the machine first."
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "What's new in the newest version",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "data = from(bucket: \"monitoring\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_changelog\" and r._field == \"text\")\n  |> last()\nnewest = (data |> group() |> max(column: \"_time\") |> findRecord(fn: (key) => true, idx: 0))._time\ndata\n  |> filter(fn: (r) => r._time == newest)\n  |> group()\n  |> sort(columns: [\"line\"])\n  |> keep(columns: [\"_value\"])\n  |> rename(columns: {_value: \"What's new\"})"
        }
      ],
      "options": {
        "showHeader": false,
        "cellHeight": "md"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Nothing yet. The appliance checks once a day.",
          "custom": {
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          }
        },
        "overrides": [
          {
            "_lonsemonsy_link": true,
            "matcher": {
              "id": "byName",
              "options": "agent.name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Alerts from this machine in Wazuh",
                    "url": "${wazuh:raw}/app/data-explorer/discover#?_a=(discover:(columns:!(rule.description,agent.name,rule.level,data.srcip),isDirty:!f,sort:!()),metadata:(indexPattern:'wazuh-alerts-*',view:discover))&_g=(filters:!(),refreshInterval:(pause:!t,value:0),time:(from:'${__from:date:iso}',to:'${__to:date:iso}'))&_q=(filters:!(),query:(language:kuery,query:'agent.name:\"${__value.raw}\"'))",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "_lonsemonsy_link": true,
            "matcher": {
              "id": "byName",
              "options": "rule.description"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "These alerts in Wazuh",
                    "url": "${wazuh:raw}/app/data-explorer/discover#?_a=(discover:(columns:!(rule.description,agent.name,rule.level,data.srcip),isDirty:!f,sort:!()),metadata:(indexPattern:'wazuh-alerts-*',view:discover))&_g=(filters:!(),refreshInterval:(pause:!t,value:0),time:(from:'${__from:date:iso}',to:'${__to:date:iso}'))&_q=(filters:!(),query:(language:kuery,query:'rule.description:\"${__value.raw}\"'))",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "_lonsemonsy_link": true,
            "matcher": {
              "id": "byName",
              "options": "data.srcip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Alerts from this IP in Wazuh",
                    "url": "${wazuh:raw}/app/data-explorer/discover#?_a=(discover:(columns:!(rule.description,agent.name,rule.level,data.srcip),isDirty:!f,sort:!()),metadata:(indexPattern:'wazuh-alerts-*',view:discover))&_g=(filters:!(),refreshInterval:(pause:!t,value:0),time:(from:'${__from:date:iso}',to:'${__to:date:iso}'))&_q=(filters:!(),query:(language:kuery,query:'data.srcip:\"${__value.raw}\"'))",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "options": {
        "mode": "markdown",
        "content": "Full history: `setup/CHANGELOG.md` in the LoNSeMonSy repository on GitHub. The appliance checks for a new version once a day."
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Last cloud backup",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_backup\" and r._field == \"ok\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: int(v: r._time) / 1000000}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "noValue": "Not set up",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "appliance",
        "label": "Open links via",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "P951FEA4DE68E13C5"
        },
        "query": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_address\")\n  |> last()\n  |> group()\n  |> sort(columns: [\"rank\"])\n  |> keep(columns: [\"_value\"])",
        "definition": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_address\")\n  |> last()\n  |> group()\n  |> sort(columns: [\"rank\"])\n  |> keep(columns: [\"_value\"])",
        "refresh": 1,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "sort": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "wazuh",
        "label": "Wazuh address",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "P951FEA4DE68E13C5"
        },
        "query": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_link\" and r.name == \"wazuh\")\n  |> last()\n  |> keep(columns: [\"_value\"])",
        "definition": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_link\" and r.name == \"wazuh\")\n  |> last()\n  |> keep(columns: [\"_value\"])",
        "refresh": 1,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "sort": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "netalertx",
        "label": "NetAlertX address",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "P951FEA4DE68E13C5"
        },
        "query": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_link\" and r.name == \"netalertx\")\n  |> last()\n  |> keep(columns: [\"_value\"])",
        "definition": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_link\" and r.name == \"netalertx\")\n  |> last()\n  |> keep(columns: [\"_value\"])",
        "refresh": 1,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "sort": 0,
        "options": [],
        "current": {}
      }
    ]
  }
}
