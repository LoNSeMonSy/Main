{
  "uid": "lons-updates",
  "title": "Updates",
  "tags": [
    "lonsemonsy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "links": [
    {
      "title": "LoNSeMonSy",
      "type": "dashboards",
      "tags": [
        "lonsemonsy"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "apps",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "_lonsemonsy": "ext-links",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"padding:2px 4px\">Other tools: &nbsp;<a href=\"${wazuh:raw}\" target=\"_blank\" rel=\"noopener\">Wazuh \u2197</a> &nbsp;\u00b7&nbsp; <a href=\"${netalertx:raw}/devices.php\" target=\"_blank\" rel=\"noopener\">Devices (NetAlertX) \u2197</a></div>"
      }
    },
    {
      "type": "stat",
      "title": "Installed version",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_version\" and r._field == \"installed\")\n  |> last()\n  |> keep(columns: [\"_value\"])"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^_value$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Newest version",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 2
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_version\" and (r._field == \"latest\" or r._field == \"update_available\"))\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _field: r._field, _value: string(v: r._value)}))\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({_value: if r.update_available == \"1\" then r.latest + \" (update available)\" else r.latest}))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^_value$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown",
          "color": {
            "mode": "fixed",
            "fixedColor": "transparent"
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": ".*update available.*",
                "result": {
                  "color": "red",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Last checked",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 2
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_version\" and r._field == \"installed\")\n  |> last()\n  |> map(fn: (r) => ({_value: int(v: r._time) / 1000000}))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^_value$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown",
          "unit": "dateTimeAsSystem"
        },
        "overrides": []
      }
    },
    {
      "type": "text",
      "title": "How to update",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 2
      },
      "options": {
        "mode": "markdown",
        "content": "Run `lsmsy update` on the server.\n\nSettings and data are kept."
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "What's new in the newest version",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "data = from(bucket: \"monitoring\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_changelog\" and r._field == \"text\")\n  |> last()\nnewest = (data |> group() |> max(column: \"_time\") |> findRecord(fn: (key) => true, idx: 0))._time\ndata\n  |> filter(fn: (r) => r._time == newest)\n  |> group()\n  |> sort(columns: [\"line\"])\n  |> keep(columns: [\"_value\"])\n  |> rename(columns: {_value: \"What's new\"})"
        }
      ],
      "options": {
        "showHeader": false,
        "cellHeight": "md"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Nothing yet. The appliance checks once a day.",
          "custom": {
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          }
        },
        "overrides": [
          {
            "_lonsemonsy_link": true,
            "matcher": {
              "id": "byName",
              "options": "agent.name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Alerts from this machine in Wazuh",
                    "url": "${wazuh:raw}/app/data-explorer/discover#?_a=(discover:(columns:!(rule.description,agent.name,rule.level,data.srcip),isDirty:!f,sort:!()),metadata:(indexPattern:'wazuh-alerts-*',view:discover))&_g=(filters:!(),refreshInterval:(pause:!t,value:0),time:(from:'${__from:date:iso}',to:'${__to:date:iso}'))&_q=(filters:!(),query:(language:kuery,query:'agent.name:\"${__value.raw}\"'))",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "_lonsemonsy_link": true,
            "matcher": {
              "id": "byName",
              "options": "rule.description"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "These alerts in Wazuh",
                    "url": "${wazuh:raw}/app/data-explorer/discover#?_a=(discover:(columns:!(rule.description,agent.name,rule.level,data.srcip),isDirty:!f,sort:!()),metadata:(indexPattern:'wazuh-alerts-*',view:discover))&_g=(filters:!(),refreshInterval:(pause:!t,value:0),time:(from:'${__from:date:iso}',to:'${__to:date:iso}'))&_q=(filters:!(),query:(language:kuery,query:'rule.description:\"${__value.raw}\"'))",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "_lonsemonsy_link": true,
            "matcher": {
              "id": "byName",
              "options": "data.srcip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Alerts from this IP in Wazuh",
                    "url": "${wazuh:raw}/app/data-explorer/discover#?_a=(discover:(columns:!(rule.description,agent.name,rule.level,data.srcip),isDirty:!f,sort:!()),metadata:(indexPattern:'wazuh-alerts-*',view:discover))&_g=(filters:!(),refreshInterval:(pause:!t,value:0),time:(from:'${__from:date:iso}',to:'${__to:date:iso}'))&_q=(filters:!(),query:(language:kuery,query:'data.srcip:\"${__value.raw}\"'))",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Last cloud backup",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"monitoring\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_backup\" and r._field == \"ok\")\n  |> last()\n  |> map(fn: (r) => ({_value: int(v: r._time) / 1000000}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "noValue": "Not set up",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^_value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "options": {
        "mode": "markdown",
        "content": "Checked once a day. Full history: `setup/CHANGELOG.md` on GitHub."
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transparent": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "appliance",
        "label": "Open links via",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "P951FEA4DE68E13C5"
        },
        "query": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_address\")\n  |> last()\n  |> group()\n  |> sort(columns: [\"rank\"])\n  |> keep(columns: [\"_value\"])",
        "definition": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_address\")\n  |> last()\n  |> group()\n  |> sort(columns: [\"rank\"])\n  |> keep(columns: [\"_value\"])",
        "refresh": 1,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "sort": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "wazuh",
        "label": "Wazuh address",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "P951FEA4DE68E13C5"
        },
        "query": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_link\" and r.name == \"wazuh\")\n  |> last()\n  |> keep(columns: [\"_value\"])",
        "definition": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_link\" and r.name == \"wazuh\")\n  |> last()\n  |> keep(columns: [\"_value\"])",
        "refresh": 1,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "sort": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "netalertx",
        "label": "NetAlertX address",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "P951FEA4DE68E13C5"
        },
        "query": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_link\" and r.name == \"netalertx\")\n  |> last()\n  |> keep(columns: [\"_value\"])",
        "definition": "from(bucket: \"monitoring\")\n  |> range(start: -3d)\n  |> filter(fn: (r) => r._measurement == \"lonsemonsy_link\" and r.name == \"netalertx\")\n  |> last()\n  |> keep(columns: [\"_value\"])",
        "refresh": 1,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "sort": 0,
        "options": [],
        "current": {}
      }
    ]
  }
}
