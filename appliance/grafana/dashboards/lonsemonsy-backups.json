          "text": "Reset",
          "variant": "hidden"
        },
        "resetAction": {
          "code": "return;",
          "confirm": false,
          "getPayload": "return {}",
          "mode": "initial",
          "payload": {}
        },
        "saveDefault": {
          "icon": "save",
          "text": "Save Default",
          "variant": "hidden"
        },
        "submit": {
          "backgroundColor": "purple",
          "foregroundColor": "yellow",
          "icon": "play",
          "text": "Run Backup Now",
          "variant": "primary"
        },
        "sync": false,
        "update": {
          "code": "const port = 5001;\nconst url = window.location.protocol + '//' + window.location.hostname + ':' + port + '/api/backup/start';\n\nreturn fetch(url, {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ source: 'grafana' })\n})\n  .then(function (r) {\n    return r.json().catch(function () { return {}; }).then(function (body) {\n      return { ok: r.ok, status: r.status, body: body };\n    });\n  })\n  .then(function (res) {\n    if (res.ok) {\n      context.grafana.notifySuccess(['Backup', 'Backup started on ' + (res.body.node || 'the node') + '.']);\n    } else if (res.status === 409) {\n      context.grafana.notifyWarning(['Backup', res.body.message || 'A backup is already running.']);\n    } else {\n      var detail = res.body.error || ('HTTP ' + res.status);\n      if (res.body.missing) { detail = 'Missing config: ' + res.body.missing.join(', '); }\n      context.grafana.notifyError(['Backup', detail]);\n    }\n    context.grafana.refresh();\n  })\n  .catch(function (e) {\n    context.grafana.notifyError([\n      'Backup',\n      'Could not reach the trigger service at ' + url + ' (' + e.message + ')'\n    ]);\n  });",
          "confirm": true,
          "contentType": "application/json",
          "getPayload": "return { source: 'grafana' };",
          "header": [],
          "method": "-",
          "payload": {},
          "payloadMode": "custom",
          "url": ""
        },
