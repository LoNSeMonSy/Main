INFLUXDB_ADMIN_USER=
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ORG=LoNSeMonSy
INFLUXDB_BUCKET=monitoring
INFLUXDB_ADMIN_TOKEN=

GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- Proxmox VE (backup-trigger service) ---
PVE_HOST=192.168.12.230
PVE_PORT=8006
PVE_NODE=mainserver
PVE_VERIFY_SSL=false

# Preferred: API token. Create with:
#   pveum user token add root@pam lonsemonsy --privsep 0
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=

# Fallback if you would rather not mint a token (leave the token pair blank):
PVE_USER=
PVE_PASSWORD=

# --- Backup job defaults ---
# PVE storage ID of the PBS target (the PVE-side name, not the PBS datastore name).
BACKUP_STORAGE=pbs-aws
# Comma-separated VMIDs; leave blank to back up every guest on the node.
BACKUP_VMIDS=
BACKUP_MODE=snapshot
BACKUP_COMPRESS=zstd

# --- backup-trigger service ---
POLL_INTERVAL_S=5
CORS_ORIGIN=*
# Optional shared secret; when set, callers must send X-Trigger-Token.
TRIGGER_TOKEN=

# --- Post-backup PBS import (Backup Tasks table) ---
# Set to true once the appliance public key is in PBS's authorized_keys.
PBS_IMPORT_ENABLED=true
PBS_HOST=192.168.12.131
PBS_SSH_USER=root

# --- Security alerts feed (alerts-feed service, port 5002) ---
# New measurement, separate from pbs_backup_main / pbs_backup_progress.
ALERT_MEASUREMENT=security_alerts
ALERTS_HOST_PORT=5002
# Rolling display window. Alerts older than this drop off the feed and the page
# returns to its blank idle state -- this is what makes it a NOC display.
ALERTS_WINDOW_MIN=15
# How often the server re-queries InfluxDB (one poller per mode, shared by all viewers).
ALERTS_POLL_INTERVAL_S=3
ALERTS_MAX_ROWS=100
# Which tab the page opens on: test | live
ALERTS_DEFAULT_MODE=test

# --- Fake alert generator (Test mode only) ---
# Writes random sample alerts tagged mode=test so the feed has something to show
# before the detection layer exists. Set to false once real alerts are flowing.
ALERTGEN_ENABLED=true
ALERTGEN_MIN_INTERVAL_S=15
ALERTGEN_MAX_INTERVAL_S=30
# Cosmetic: subnet the fake "new device" alerts appear to come from.
ALERTGEN_LAN_PREFIX=192.168.12

# --- Tailscale audit logs (tailscale-audit service) ---
# Create ONE of the two credentials below in the Tailscale admin console.
#
# Preferred -- OAuth client, https://login.tailscale.com/admin/settings/oauth
#   "Generate OAuth client", grant ONLY the read permission for
#   Logs > Configuration Audit Logs (scope: logs:configuration:read), no others.
#   Copy the client ID and client secret into the two variables below.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
# Fallback -- personal API key, https://login.tailscale.com/admin/settings/keys
#   "Generate access token". Unscoped and expires after at most 90 days, so it
#   is the worse choice for something unattended. Leave blank if using OAuth.
TAILSCALE_API_KEY=
# Blank means "the tailnet the credential above belongs to", which is what you
# want. Only set this if the credential can see more than one tailnet.
TAILSCALE_TAILNET=
# Flip to true once one of the credentials above is filled in.
TSAUDIT_ENABLED=false
AUDIT_MEASUREMENT=audit_log
AUDIT_POLL_INTERVAL_S=300
# First run only, when the measurement is empty. Tailscale keeps configuration
# audit logs for 90 days, so anything above 90 is capped.
AUDIT_BACKFILL_DAYS=30
# Each poll re-reads this far behind the cursor, so an event that becomes
# queryable late is still picked up. Re-writes are idempotent.
AUDIT_OVERLAP_MIN=10

# --- Proxmox VE audit source (audit-collector service) ---
# On by default and needs NO new credentials: it reuses the PVE_TOKEN_ID /
# PVE_TOKEN_SECRET pair above that backup-trigger already uses. The token needs
# Sys.Audit on / to read /cluster/log.
PVEAUDIT_ENABLED=true
# /cluster/log cannot be filtered by time server-side, so each poll pulls this
# many recent entries and discards what it already stored.
PVEAUDIT_LOG_MAX=500
PVEAUDIT_TASK_LIMIT=500

# --- Hub page (alerts-feed serves all three sections) ---
AUDIT_WINDOW_DAYS=30
# The profile drawer reaches back further than the table: the point of opening
# one is "what has this thing been doing", which is a longer question.
AUDIT_PROFILE_DAYS=90
AUDIT_MAX_ROWS=500
# Backups nav link. Leave GRAFANA_URL blank so the page derives the host from
# whatever address the hub was opened on -- a hardcoded IP breaks over Tailscale.
GRAFANA_URL=
GRAFANA_PORT=3000
GRAFANA_DASHBOARD_PATH=/d/e01512b5-eef3-48f4-9c5e-f5f512b6bb7f/lonsemonsy-backups

# --- Wazuh indexer login for the Grafana OpenSearch datasource ---
# Grafana reads Wazuh alerts through a DEDICATED READ-ONLY indexer user, never admin.
# Setup creates an internal user `grafana` mapped to a custom role `grafana_ro`
# (search + index-metadata reads on wazuh-*, plus cluster:monitor for version
# detection -- the OpenSearch plugin needs all of these). The password lives only
# here in .env. To (re)create the user, see the notes in docs/PROGRESS.md.
WAZUH_INDEXER_USER=grafana
WAZUH_INDEXER_PASSWORD=
