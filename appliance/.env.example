# LoNSeMonSy settings. Copy to .env, fill in the top section, then run setup/setup.sh.
# Anything left blank that is a password or token gets generated for you.

# --- Databases and dashboard (leave blank, generated) ---
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ORG=LoNSeMonSy
INFLUXDB_BUCKET=monitoring
INFLUXDB_ADMIN_TOKEN=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Leave blank. Only set it if you reach Grafana through a hostname or VPN,
# e.g. http://monitor.example.lan:3000
GRAFANA_ROOT_URL=

# --- Network scanner (NetAlertX) ---
# Leave blank and setup.sh fills in this machine's own network, e.g.
# "192.168.1.0/24 --interface=eth0".
SCAN_SUBNETS=
NETALERTX_PORT=20211
NETALERTX_GRAPHQL_PORT=20212
TZ=

# --- Wazuh (Grafana reads alerts with a READ-ONLY user, never admin) ---
# How to create it: https://documentation.wazuh.com/current/user-manual/user-administration/rbac.html
WAZUH_INDEXER_USER=grafana
WAZUH_INDEXER_PASSWORD=

# --- Email alerts (optional) ---
# Gmail needs 2-Step Verification and an App Password, never your real password.
# https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/#smtp
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=LoNSeMonSy
ALERT_EMAIL_TO=


# --- Updates ---
# Which release channel to follow. The Grafana banner shows when a newer version is out.
UPDATE_BRANCH=main
# Blank = the GitHub repo this folder was cloned from.
UPDATE_REPO=

